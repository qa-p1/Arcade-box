{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcade Box",
  "version": "0.1.0",
  "identifier": "dev.arcadebox.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Arcade Box",
        "width": 740,
        "height": 740,
        "minWidth": 320,
        "minHeight": 116,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "capabilities": ["island", "pinned-image"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "dmg"
    ],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.0"
    }
  }
}
