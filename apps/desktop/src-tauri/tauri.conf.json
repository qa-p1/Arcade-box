{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcade Box",
  "version": "0.3.5",
  "identifier": "dev.arcadebox.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Arcade Box",
        "width": 740,
        "height": 740,
        "minWidth": 320,
        "minHeight": 116,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "create": false
      },
      {
        "label": "dashboard",
        "title": "Dashboard — Arcade Box",
        "url": "dashboard.html",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "resizable": true,
        "visible": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "capabilities": [
        "island",
        "pinned-image"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.0"
    },
    "publisher": "qa-p1",
    "homepage": "https://github.com/qa-p1/Arcade-catalog",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "template": "./windows/installer.nsi",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
