{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcade-box.dev/schemas/tool-catalog-v1.json",
  "title": "Arcade Box Tool Catalog",
  "description": "Machine-readable discovery catalog. Entries describe intended capabilities and do not claim implementation unless status says implemented.",
  "type": "object",
  "required": ["schemaVersion", "apiVersion", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "apiVersion": { "const": "1" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["planned", "partial", "implemented"]
    },
    "tool": {
      "type": "object",
      "required": [
        "id", "version", "apiVersion", "name", "description", "category",
        "aliases", "privacyClass", "inputs", "outputs", "providers",
        "permissions", "execution", "status", "platforms"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^arcade\\.[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)?$" },
        "apiVersion": { "const": "1" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "privacyClass": { "type": "string", "enum": ["LOCAL", "NETWORK", "CLOUD"] },
        "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "providers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "permissions": {
          "type": "object",
          "properties": {
            "filesystem": {
              "type": "object",
              "properties": {
                "read": { "type": "string", "enum": ["none", "user-selected"] },
                "write": { "type": "string", "enum": ["none", "user-selected"] }
              },
              "additionalProperties": true
            },
            "network": { "type": "string", "enum": ["none", "optional", "required"] }
          },
          "additionalProperties": true
        },
        "execution": {
          "type": "object",
          "required": ["runtime"],
          "properties": {
            "runtime": { "type": "string", "enum": ["builtin", "wasm", "provider"] }
          },
          "additionalProperties": true
        },
        "status": { "$ref": "#/$defs/status" },
        "platforms": {
          "type": "object",
          "required": ["windows", "macos", "wayland", "x11"],
          "properties": {
            "windows": { "$ref": "#/$defs/platformStatus" },
            "macos": { "$ref": "#/$defs/platformStatus" },
            "wayland": { "$ref": "#/$defs/platformStatus" },
            "x11": { "$ref": "#/$defs/platformStatus" }
          },
          "additionalProperties": { "$ref": "#/$defs/platformStatus" }
        },
        "phrases": { "type": "array", "items": { "type": "string" } },
        "relatedTools": { "type": "array", "items": { "type": "string", "pattern": "^arcade\\." } },
        "ui": { "$ref": "#/$defs/standardUi" },
        "presets": {
          "description": "Named option sets other Arcade apps offer as one-click actions (box:<tool-id>#<preset>).",
          "type": "array",
          "items": { "$ref": "#/$defs/preset" }
        },
        "link": {
          "description": "How Arcade Link peers present this tool.",
          "type": "object",
          "properties": {
            "featuredFor": {
              "description": "Link content types for which peers show this tool's presets inline (3-5 per type); the rest go under \"More in Arcade Box...\".",
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "preset": {
      "type": "object",
      "required": ["id", "name", "options"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "options": { "type": "object" }
      },
      "additionalProperties": false
    },
    "platformStatus": {
      "type": "string",
      "enum": ["planned", "partial", "conditional", "implemented", "unsupported"]
    },
    "standardUi": {
      "type": "object",
      "required": ["version", "input"],
      "properties": {
        "version": { "const": 1 },
        "input": {
          "type": "object",
          "required": ["kind", "label"],
          "properties": {
            "kind": { "type": "string", "enum": ["none", "text", "url", "file", "files", "folder"] },
            "label": { "type": "string", "minLength": 1 },
            "minItems": { "type": "integer", "minimum": 0 },
            "maxItems": { "type": "integer", "minimum": 1 },
            "sortable": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "controls": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/uiControl" } }
      },
      "additionalProperties": false
    },
    "uiControl": {
      "type": "object",
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["text", "password", "number", "select", "toggle", "directory"] },
        "default": {},
        "choices": { "type": "array", "items": { "$ref": "#/$defs/uiChoice" } },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "placeholder": { "type": "string" },
        "help": { "type": "string" },
        "advanced": { "type": "boolean" },
        "showWhen": {
          "type": "object",
          "required": ["key"],
          "properties": { "key": { "type": "string" }, "equals": {}, "oneOf": { "type": "array", "minItems": 1, "items": {} } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "uiChoice": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "requires": {
          "type": "array",
          "description": "Provider capabilities the choice needs. Hosts disable it when no compatible provider offers them all.",
          "items": { "type": "string", "pattern": "^[a-z0-9]+:[A-Za-z0-9_.-]+$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
